{
  "name": "moduoduo-writing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "check": "node scripts/check.mjs",
    "check:design": "node scripts/design-check.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:interactions": "node scripts/interactions.mjs",
    "test:navigation": "node scripts/navigation-check.mjs",
    "test:billing": "node scripts/billing-check.mjs",
    "test:api": "node scripts/api-check.mjs",
    "test:functions": "node scripts/functionality-check.mjs",
    "test:generation": "node scripts/generation-check.mjs",
    "test": "npm run check && npm run test:interactions && npm run test:navigation && npm run test:billing && npm run test:api && npm run test:functions && npm run test:generation && npm run test:cloud && npm run test:workspace && npm run test:pipeline && npm run check:design && npm run test:upgrades",
    "test:cloud": "node scripts/cloud-check.mjs",
    "test:workspace": "node scripts/workspace-check.mjs",
    "test:pipeline": "node scripts/pipeline-check.mjs",
    "test:home-redesign": "node scripts/home-redesign-check.mjs",
    "test:revisions": "node scripts/revision-check.mjs",
    "test:memory-queue": "node scripts/memory-queue-check.mjs",
    "test:submission-versions": "node scripts/submission-versions-check.mjs",
    "test:account-ui": "node scripts/account-ui-check.mjs",
    "test:extended-workspace": "node scripts/extended-workspace-check.mjs",
    "test:service-upgrade": "node scripts/service-upgrade-check.mjs",
    "test:upgrades": "npm run test:home-redesign && npm run test:revisions && npm run test:memory-queue && npm run test:submission-versions && npm run test:account-ui && npm run test:extended-workspace && npm run test:service-upgrade && npm run test:evaluation && npm run test:billing-concurrency && npm run test:home-resume && npm run test:workspace-feedback && npm run test:conversation-api && npm run test:conversation-data && npm run test:conversation-ui && npm run test:public-home && npm run test:auth-identity && npm run test:auth-providers && npm run test:auth-api && npm run test:login-methods && npm run test:login-settings && npm run test:admin-store && npm run test:admin-api && npm run test:admin-provision && npm run test:admin-ui && npm run test:admin-boundary",
    "test:evaluation": "node scripts/writing-evaluation-check.mjs",
    "test:billing-concurrency": "node scripts/billing-concurrency-check.mjs",
    "test:home-resume": "node scripts/home-resume-check.mjs",
    "test:workspace-feedback": "node scripts/workspace-feedback-check.mjs",
    "test:conversation-api": "node scripts/conversation-api-check.mjs",
    "test:conversation-data": "node scripts/conversation-data-check.mjs",
    "test:conversation-ui": "node scripts/conversation-ui-check.mjs",
    "test:public-home": "node scripts/public-home-check.mjs && node scripts/public-home-app-check.mjs",
    "test:auth-identity": "node scripts/auth-identity-check.mjs",
    "test:auth-providers": "node scripts/auth-providers-check.mjs",
    "test:auth-api": "node scripts/auth-api-check.mjs",
    "test:login-methods": "node scripts/login-methods-check.mjs",
    "test:login-settings": "node scripts/login-settings-check.mjs",
    "admin:init": "node scripts/provision-admin.mjs --stdin",
    "test:admin-store": "node scripts/admin-store-check.mjs",
    "test:admin-api": "node scripts/admin-api-check.mjs",
    "test:admin-provision": "node scripts/admin-provision-check.mjs",
    "test:admin-ui": "node scripts/admin-ui-check.mjs",
    "test:admin-boundary": "node scripts/admin-boundary-check.mjs"
  },
  "dependencies": {
    "ali-oss": "^6.23.0",
    "lucide-react": "^0.468.0",
    "nodemailer": "^10.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "react-test-renderer": "^19.3.1",
